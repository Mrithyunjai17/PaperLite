{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperLite",
  "version": "0.1.0",
  "identifier": "com.paperlite.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PaperLite",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "dragDropEnabled": false,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "A small, private, offline PDF reader and annotator",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
